{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "ECM Design Tokens",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"palette": [
				{ "slug": "bg", "name": "Baggrund", "color": "#F7F6F2" },
				{ "slug": "surface", "name": "Overflade (hvid)", "color": "#FFFFFF" },
				{ "slug": "ink", "name": "Ink (mørk tekst)", "color": "#15161B" },
				{ "slug": "ink-soft", "name": "Ink blød", "color": "#46474E" },
				{ "slug": "ink-faint", "name": "Ink svag", "color": "#6B6C74" },
				{ "slug": "accent", "name": "Accent (CTA-rød)", "color": "#C0392B" },
				{ "slug": "accent-strong", "name": "Accent mørk (hover)", "color": "#9C2F22" },
				{ "slug": "accent-2", "name": "Accent 2 (gul)", "color": "#FFC83D" },
				{ "slug": "focus", "name": "Fokusring (blå)", "color": "#2A5DFF" }
			],
			"gradients": [],
			"duotone": [],
			"custom": true,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Space Grotesk (overskrifter)",
					"fontFamily": "'Space Grotesk', 'Inter', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"src": [ "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Inter (brødtekst)",
					"fontFamily": "'Inter', sans-serif"
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono (labels)",
					"fontFamily": "'IBM Plex Mono', monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Lille", "size": "0.9rem" },
				{ "slug": "medium", "name": "Normal", "size": "1rem" },
				{ "slug": "large", "name": "Lede", "size": "clamp(1.05rem, 1.6vw, 1.25rem)" },
				{ "slug": "x-large", "name": "H2", "size": "clamp(1.9rem, 3.6vw, 3rem)" },
				{ "slug": "xx-large", "name": "H1", "size": "clamp(2.3rem, 6.4vw, 4.4rem)" }
			],
			"lineHeight": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "slug": "10", "size": "8px", "name": "1" },
				{ "slug": "20", "size": "14px", "name": "2" },
				{ "slug": "30", "size": "20px", "name": "3" },
				{ "slug": "40", "size": "32px", "name": "4" },
				{ "slug": "50", "size": "48px", "name": "5" },
				{ "slug": "60", "size": "64px", "name": "6" },
				{ "slug": "70", "size": "96px", "name": "7" },
				{ "slug": "80", "size": "128px", "name": "8" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "16px",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.01em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.95em", "bottom": "0.95em", "left": "1.6em", "right": "1.6em" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-strong)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"fontSize": "1.35rem",
					"letterSpacing": "-0.02em"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "0.95rem",
					"fontWeight": "500"
				},
				"color": {
					"text": "var(--wp--preset--color--ink-soft)"
				}
			},
			"core/search": {
				"border": { "radius": "999px" }
			},
			"core/details": {
				"border": {
					"color": "var(--wp--preset--color--ink)",
					"width": "0px",
					"style": "solid"
				},
				"spacing": {
					"padding": { "top": "20px", "bottom": "20px" }
				}
			}
		}
	},
	"customTemplates": [
		{ "name": "page-uddannelse", "title": "ECM — Uddannelsen", "postTypes": [ "page" ] },
		{ "name": "page-studiemiljoe", "title": "ECM — Studiemiljø", "postTypes": [ "page" ] },
		{ "name": "page-cases", "title": "ECM — Cases & projekter", "postTypes": [ "page" ] },
		{ "name": "page-karriere", "title": "ECM — Karriere + Muligheder", "postTypes": [ "page" ] },
		{ "name": "page-praktisk-info", "title": "ECM — Praktisk info", "postTypes": [ "page" ] },
		{ "name": "page-faq", "title": "ECM — FAQ", "postTypes": [ "page" ] },
		{ "name": "page-moed-os", "title": "ECM — Mød os", "postTypes": [ "page" ] },
		{ "name": "page-kontakt", "title": "ECM — Kontakt", "postTypes": [ "page" ] },
		{ "name": "page-test", "title": "ECM — Er ECM noget for dig? (test)", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Sidehoved", "area": "header" },
		{ "name": "footer", "title": "Sidefod", "area": "footer" }
	]
}
